---
import BaseLayout from '../layouts/BaseLayout.astro';
import { href } from '../lib/site';
---
<BaseLayout title="Page not found | WebMirror" description="This page does not exist." path="/404/" noindex>
  <div class="wrap nf">
    <p class="eyebrow">Error 404</p>
    <h1>Page not found</h1>
    <p class="lead">The page you wanted does not exist or has moved.</p>
    <p><a class="btn btn-primary" href={href('/')}>Go to the home page</a></p>
  </div>
</BaseLayout>
<style>
  .nf { padding-block: var(--s-8); }
</style>
