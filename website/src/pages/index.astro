---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMockup from '../components/HeroMockup.astro';
import HowDiagram from '../components/HowDiagram.astro';
import DownloadButton from '../components/DownloadButton.astro';
import PlayBadge from '../components/PlayBadge.astro';
import AndroidRobot from '../components/AndroidRobot.astro';
import FeatureCard from '../components/FeatureCard.astro';
import Callout from '../components/Callout.astro';
import FaqItem from '../components/FaqItem.astro';
import { FAQS } from '../data/faq';
import { getRelease } from '../lib/release';
import { abs, href, REPO } from '../lib/site';

const r = await getRelease();
const app = {
  '@type': 'SoftwareApplication',
  name: 'WebMirror',
  description: 'Free, open-source Android app that mirrors the phone screen, with sound, to the Tesla in-car browser over Wi-Fi.',
  url: abs('/'),
  image: abs('/og.png'),
  operatingSystem: 'Android 10+',
  applicationCategory: 'UtilitiesApplication',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: 'https://opensource.org/licenses/MIT',
  codeRepository: REPO,
  author: { '@type': 'Person', name: 'danyk20', url: 'https://github.com/danyk20' },
  ...(r.version ? { softwareVersion: r.version } : {}),
  ...(r.publishedAt ? { datePublished: r.publishedAt.slice(0, 10) } : {}),
  downloadUrl: r.url,
};
const teaser = FAQS.slice(0, 4);
---
<BaseLayout
  title="WebMirror: mirror your Android phone to your Tesla screen"
  description="Free, private Tesla screen mirroring from Android. Share your phone screen, with sound, to the Tesla browser over Wi-Fi. No registration, no tracking: your data stays on your device."
  path="/"
  jsonLd={[app]}
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">Free and open source</p>
        <h1>Your phone, on your Tesla screen</h1>
        <p class="lead">Wireless screen mirroring from Android to the Tesla browser. No app, cable or account in the car.</p>
        <p class="privacy-line">No registration. No tracking. Your data never leaves your devices.</p>
        <div class="cta">
          <DownloadButton size="lg" detail />
          <a class="btn btn-secondary btn-lg" href="#how-it-works">How it works</a>
        </div>
        <div class="badges">
          <PlayBadge />
          <p class="muted small platform"><AndroidRobot size={22} /> Android 10 or newer</p>
        </div>
      </div>
      <div class="hero-art"><HeroMockup /></div>
    </div>
  </section>

  <section class="trust" aria-label="Highlights">
    <ul class="wrap">
      <li>No registration</li>
      <li>Zero data collection</li>
      <li>Stays on your device</li>
      <li>Free and open source</li>
    </ul>
  </section>

  <section class="section" id="how-it-works">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2>Three steps to a mirrored screen</h2>
      <ol class="steps three">
        <li><h3>Turn on the hotspot</h3><p>Share your phone's hotspot and join it from the Tesla. Turn on "Remain connected in Drive".</p></li>
        <li><h3>Tap Start</h3><p>Open WebMirror on the phone, tap Start and allow screen sharing.</p></li>
        <li><h3>Open the address</h3><p>In the Tesla browser, open the address shown in the app or scan its QR code. Enter the PIN once.</p></li>
      </ol>
      <HowDiagram />
      <p class="more"><a href={href('/setup/')}>Read the full setup guide</a></p>
    </div>
  </section>

  <section class="section section-alt" id="features">
    <div class="wrap">
      <p class="eyebrow">Features</p>
      <h2>Built for the Tesla browser</h2>
      <ul class="grid">
        <FeatureCard title="Low delay">About 40 ms from the phone screen to the browser picture, measured on a clean Wi-Fi link.</FeatureCard>
        <FeatureCard title="Up to 60 fps">The default Smoothest setting sends 60 fps and falls back to 30 fps by itself if the car cannot keep up.</FeatureCard>
        <FeatureCard title="Sound in sync">Play the phone's sound in the Tesla browser, in sync with the picture, or over Bluetooth with a delay slider.</FeatureCard>
        <FeatureCard title="Touch and typing">Tap, swipe and pinch on the Tesla screen. Type with the phone keyboard or the Tesla browser's own keyboard.</FeatureCard>
        <FeatureCard title="PIN pairing">A 4 or 6 digit PIN stops others on the hotspot from watching or controlling your phone.</FeatureCard>
        <FeatureCard title="Free secure address">Get a free https address with DuckDNS and Let's Encrypt in about two minutes. It renews by itself.</FeatureCard>
        <FeatureCard title="Heat protection">If the phone gets hot, WebMirror lowers frame rate and quality, then restores them when it cools down.</FeatureCard>
        <FeatureCard title="Quick Settings tile">Start and stop mirroring from the Android Quick Settings panel without opening the app.</FeatureCard>
      </ul>
    </div>
  </section>

  <section class="section privacy" id="privacy">
    <div class="wrap">
      <div class="privacy-head">
        <p class="eyebrow">Private by design</p>
        <h2>Your data is yours. It stays on your device.</h2>
        <p class="lead">WebMirror does not collect, store or share any data about you: not for analytics, not for advertising, not for anything else. There is no WebMirror server. Your screen travels directly from your phone to the browser you pair, and nowhere else.</p>
      </div>
      <ul class="grid">
        <FeatureCard title="No registration">No account, no sign-in, no email address, no phone number. Install it and use it.</FeatureCard>
        <FeatureCard title="Zero data collection">No analytics, no crash reporting, no advertising IDs, no tracking SDKs. The developer receives nothing.</FeatureCard>
        <FeatureCard title="Stays on your device">Settings, paired browsers and keys are kept only on the phone, secrets encrypted in the Android Keystore. Cloud backup is off.</FeatureCard>
        <FeatureCard title="No cloud in between">Picture, sound and touches go over your phone's own hotspot. No relay server, no recording, nothing to leak.</FeatureCard>
      </ul>

      <div class="flow">
        <h3>Where your data goes, step by step</h3>
        <ol class="steps flow-steps">
          <li><h4>Your private network</h4><p>The phone's own Wi-Fi hotspot connects phone and car. Only devices you let in can join.</p></li>
          <li><h4>A server inside the app</h4><p>WebMirror runs a tiny web server on the phone itself, reachable only on your hotspot, never from the internet.</p></li>
          <li><h4>The car proves it may watch</h4><p>The car browser enters the PIN shown on the phone once and receives a random pairing key.</p></li>
          <li><h4>Phone to car, directly</h4><p>Picture and sound are encoded on the phone and sent straight to the paired browser. Nothing is recorded.</p></li>
          <li><h4>Stop means stop</h4><p>Tap Stop and capture ends, the server shuts down, and nothing is left behind except your settings.</p></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="security">
    <div class="wrap">
      <p class="eyebrow">Security</p>
      <h2>Why it is safe</h2>
      <p class="lead">Safety comes from the design, not from promises: there is no account to steal and no server to break into.</p>
      <ul class="grid">
        <FeatureCard title="Nothing to breach">No backend, no user database. Data that is never collected cannot be leaked, sold or handed over.</FeatureCard>
        <FeatureCard title="Only paired browsers">Without the PIN a browser sees nothing. Pairing keys come from a cryptographic random generator.</FeatureCard>
        <FeatureCard title="Guessing is blocked">After 5 wrong PINs within a minute, all PIN entry locks for a minute. Unpair every browser with one tap.</FeatureCard>
        <FeatureCard title="Encrypted connection">With the free secure address, picture, sound and touches are encrypted with HTTPS and a real Let's Encrypt certificate.</FeatureCard>
        <FeatureCard title="Android stays in control">Android asks your permission every time screen sharing starts and shows while it runs. Stop it any time.</FeatureCard>
        <FeatureCard title="Control is opt-in">Control from the car is off until you turn it on. The touch service only injects taps and cannot read your screen.</FeatureCard>
        <FeatureCard title="Signed releases">Every release is signed with one published key. Android installs an update only if the signature matches.</FeatureCard>
        <FeatureCard title="Open source">Every line of code is public under the MIT license, so anyone can verify each of these points.</FeatureCard>
      </ul>
      <p class="more"><a href={href('/privacy/')}>Read the privacy policy</a></p>
    </div>
  </section>

  <section class="section" id="compare">
    <div class="wrap">
      <p class="eyebrow">Compare</p>
      <h2>How WebMirror compares</h2>
      <p class="lead">Other ways to get a phone onto a Tesla screen are hardware boxes that plug into the car, and mirroring apps from app stores. Here is how they usually differ.</p>
      <div class="table-wrap">
        <table class="data-table compare">
          <caption>WebMirror and typical alternatives</caption>
          <thead><tr><th scope="col"></th><th scope="col" class="us">WebMirror</th><th scope="col">Hardware boxes</th><th scope="col">Other mirroring apps</th></tr></thead>
          <tbody>
            <tr><th scope="row">Price</th><td class="us">Free</td><td>Paid device, can cost hundreds of euros</td><td>Usually ads, a subscription or a paid unlock</td></tr>
            <tr><th scope="row">Extra hardware</th><td class="us">None</td><td>A box plugged into the car</td><td>None</td></tr>
            <tr><th scope="row">Registration or email</th><td class="us">None</td><td>Sometimes</td><td>Usually none</td></tr>
            <tr><th scope="row">Data collection</th><td class="us">None, verifiable in public code</td><td>Trust the seller</td><td>Many collect usage data or device IDs</td></tr>
            <tr><th scope="row">Cloud or relay server</th><td class="us">None, phone to car directly</td><td>Varies</td><td>Some use one</td></tr>
            <tr><th scope="row">Open source</th><td class="us">Yes, MIT</td><td>Some</td><td>Rarely</td></tr>
            <tr><th scope="row">Sound in sync in the car</th><td class="us">Yes</td><td>Usually</td><td>Not always</td></tr>
            <tr><th scope="row">Touch and typing from the car</th><td class="us">Yes</td><td>Usually</td><td>Not always</td></tr>
            <tr><th scope="row">Encrypted HTTPS link</th><td class="us">Free certificate set up on the phone</td><td>Not applicable</td><td>Rarely offered</td></tr>
            <tr><th scope="row">Measured delay</th><td class="us">About 40 ms, published</td><td>Rarely published</td><td>Rarely published</td></tr>
          </tbody>
        </table>
      </div>
      <p class="muted small">Based on public information about alternatives available in November 2026. Products differ, so check the details of any specific product. WebMirror is Android only; if you use an iPhone, look at the apps in the App Store.</p>
    </div>
  </section>

  <section class="section section-alt" id="performance">
    <div class="wrap perf">
      <div>
        <p class="eyebrow">Performance</p>
        <h2>Measured, not promised</h2>
        <p class="lead">Delay from the phone screen to the browser picture, on a clean Wi-Fi link.</p>
        <p class="muted">At a desk, the 60 fps option delivered 59 to 60 fps with about 32 ms delay and no dropped frames while scrolling. It has not been measured in a car yet. Videos reach 60 fps only if the video itself is 60 fps. Most are 24 to 30 fps.</p>
        <p class="muted">Measured with the app's built-in automatic test on a Samsung Galaxy S22, at a desk and in a car.</p>
      </div>
      <div class="table-wrap">
        <table class="data-table">
          <caption>Picture delay by mode</caption>
          <thead><tr><th scope="col">Mode</th><th scope="col">Delay</th></tr></thead>
          <tbody>
            <tr><th scope="row">Picture only</th><td>about 40 ms</td></tr>
            <tr><th scope="row">Picture only, 60 fps (desk)</th><td>about 32 ms</td></tr>
            <tr><th scope="row">Browser sound, Fast profile</th><td>about 140 ms</td></tr>
            <tr><th scope="row">Browser sound, High quality profile</th><td>about 190 ms</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap">
      <Callout kind="safety">
        <p>WebMirror is for passengers. The driver must never watch or operate the mirrored screen while driving. Follow the traffic laws of your country.</p>
      </Callout>
    </div>
  </section>

  <section class="section section-alt" id="faq">
    <div class="wrap wrap-text-center">
      <p class="eyebrow">FAQ</p>
      <h2>Common questions</h2>
      {teaser.map((f) => <FaqItem q={f.q}><p>{f.a}</p></FaqItem>)}
      <p class="more"><a href={href('/faq/')}>See all questions</a></p>
    </div>
  </section>

  <section class="section final">
    <div class="wrap">
      <h2>Put your phone on the big screen</h2>
      <p class="lead">Free, open source and installed in a minute.</p>
      <div class="cta center">
        <DownloadButton size="lg" detail />
        <a class="btn btn-secondary btn-lg" href={href('/setup/')}>Read the setup guide</a>
      </div>
      <div class="center"><PlayBadge /></div>
    </div>
  </section>
</BaseLayout>
<style>
  .hero { padding-block: clamp(40px, 7vw, 96px) clamp(32px, 5vw, 64px); background: radial-gradient(900px 480px at 80% 0%, rgb(30 79 216 / .22), transparent 70%); }
  .hero-grid { display: grid; gap: var(--s-6); align-items: center; }
  .hero-text h1 { margin-bottom: var(--s-3); }
  .hero-text .lead { max-width: 34ch; margin-bottom: var(--s-4); }
  .cta { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-bottom: var(--s-4); }
  .cta.center { justify-content: center; }
  .privacy-line { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; margin-bottom: var(--s-4); }
  .privacy-line::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--success); flex: none; }
  .privacy-head { max-width: 760px; }
  .flow { margin-top: var(--s-6); }
  .flow h3 { font-size: 1.25rem; margin-bottom: var(--s-3); }
  .flow-steps { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); margin-block: var(--s-3) 0; }
  .flow-steps > li { padding: 60px var(--s-3) var(--s-3); }
  .flow-steps h4 { font-size: 1.0625rem; margin-bottom: var(--s-2); }
  .flow-steps p { margin: 0; color: var(--text-muted); }
  .compare td:last-child { font-weight: 400; font-family: inherit; white-space: normal; }
  .compare th[scope="row"] { font-weight: 600; }
  .compare .us { color: var(--text); font-weight: 600; background: rgb(30 79 216 / .14); }
  .badges { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); }
  .badges p { margin: 0; }
  .platform { display: inline-flex; align-items: center; gap: 8px; }
  .small { font-size: var(--fs-sm); }
  .hero-art { min-width: 0; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1fr 1.1fr; } }

  .trust { border-block: 1px solid var(--line); background: var(--surface); }
  .trust ul { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--s-2) var(--s-4); margin-block: 0; padding-block: var(--s-3); text-align: center; font-weight: 600; font-family: var(--font-display); }
  .trust li { padding: var(--s-1) 0; }
  .trust li::before { content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--success); margin-right: 10px; }

  .three { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); margin-block: var(--s-5); }
  .three > li { padding: 64px var(--s-4) var(--s-4); }
  .three > li::before { top: var(--s-4); left: var(--s-4); }
  .three h3 { font-size: 1.25rem; }
  .three p { margin: 0; color: var(--text-muted); }
  .more { margin-top: var(--s-4); font-weight: 600; }

  .grid { list-style: none; padding: 0; margin: var(--s-5) 0 0; display: grid; gap: var(--s-3); grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }

  .perf { display: grid; gap: var(--s-6); align-items: start; }
  @media (min-width: 900px) { .perf { grid-template-columns: 1fr 1fr; } }
  .section-tight { padding-block: var(--s-4); }
  .wrap-text-center { max-width: 820px; }
  .final { text-align: center; }
  .final .center { display: flex; justify-content: center; }
</style>
