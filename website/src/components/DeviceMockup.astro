---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  screenshot: ImageMetadata;
  alt: string;
  frame?: 'phone' | 'car';
  /** Override the `sizes` attribute (defaults depend on the frame). */
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const {
  screenshot,
  alt,
  frame = 'phone',
  sizes = frame === 'car' ? '(min-width: 900px) 360px, 70vw' : '(min-width: 900px) 320px, 80vw',
  loading = 'lazy',
} = Astro.props;

const ratio = `${screenshot.width} / ${screenshot.height}`;
---

<div class:list={['device', `device--${frame}`]}>
  <div class="bezel">
    <div class="screen" style={`--shot-ratio: ${ratio}`}>
      <Picture
        src={screenshot}
        alt={alt}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[240, 360, 480, 720]}
        sizes={sizes}
        loading={loading}
        decoding="async"
      />
    </div>
  </div>
</div>

<style>
  .device {
    container-type: inline-size;
    width: 100%;
    margin-inline: auto;
  }
  .bezel {
    position: relative;
    background: linear-gradient(160deg, #222836 0%, #0c0f16 55%, #07090d 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.09),
      inset 0 1px 0 rgb(255 255 255 / 0.18),
      0 30px 60px -24px rgb(0 0 0 / 0.8),
      0 0 0 1px rgb(0 0 0 / 0.6);
  }
  .screen {
    position: relative;
    overflow: hidden;
    background: #000;
    line-height: 0;
  }
  .screen :global(picture),
  .screen :global(img) {
    display: block;
  }

  /* Phone: portrait, screen has the screenshot's own aspect ratio. */
  .device--phone {
    max-width: 320px;
  }
  .device--phone .bezel {
    padding: 3.4cqw;
    border-radius: 14cqw;
  }
  .device--phone .bezel::after {
    /* power button */
    content: '';
    position: absolute;
    right: -0.9cqw;
    top: 26%;
    width: 0.9cqw;
    height: 11%;
    border-radius: 0 0.5cqw 0.5cqw 0;
    background: #1a1f2b;
  }
  .device--phone .screen {
    aspect-ratio: var(--shot-ratio);
    border-radius: 10.8cqw;
  }
  .device--phone .screen :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Car: wide landscape centre display, screenshot centred with black sides. */
  .device--car {
    max-width: 720px;
  }
  .device--car .bezel {
    padding: 1.4cqw;
    border-radius: 3.2cqw;
  }
  .device--car .screen {
    aspect-ratio: 16 / 10;
    border-radius: 2cqw;
    display: flex;
    justify-content: center;
  }
  .device--car .screen :global(picture) {
    height: 100%;
    aspect-ratio: var(--shot-ratio);
  }
  .device--car .screen :global(img) {
    height: 100%;
    width: auto;
    aspect-ratio: var(--shot-ratio);
  }
</style>
