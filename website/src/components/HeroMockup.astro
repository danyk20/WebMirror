---
import ui from '../assets/player-ui.svg';
import road from '../assets/road-scene.svg';
import roadB from '../assets/road-scene-b.svg';
import roadC from '../assets/road-scene-c.svg';
import navmap from '../assets/nav-map.svg';

const km = ['12.4', '12.3', '12.2'];
const turn = ['250', '200', '150', '100', '50'];
const times = ['1:24', '1:38', '1:55', '2:18', '2:41', '2:30', '2:12'];
// Signal arcs: same geometry as the app icon (concentric arcs, +/-50 degrees).
const cx = 25.6;
const cy = 30;
const arcs = [7, 12, 17].map((r) => {
  const dx = (r * Math.cos((50 * Math.PI) / 180)).toFixed(2);
  const dy = (r * Math.sin((50 * Math.PI) / 180)).toFixed(2);
  return `M${(cx + Number(dx)).toFixed(2)} ${(cy - Number(dy)).toFixed(2)}A${r} ${r} 0 0 1 ${(cx + Number(dx)).toFixed(2)} ${(cy + Number(dy)).toFixed(2)}`;
});
---

<div
  class="hero-mockup"
  role="img"
  aria-label="Illustration: an Android phone, held in landscape, is mirrored full screen on a car centre display while the car is driving. A passenger on the right-hand side touches the video progress bar on the car display and drags it forward and back; the time stamp changes and the same position and ripple appear on the phone. The passenger then taps a split-screen button: the phone turns to portrait and the display splits into the car's navigation map, with the route moving forward and a distance countdown, next to the portrait phone picture, a music player. The passenger's hand has left. The phone then turns back to landscape and the display returns to full screen."
>
  <div class="glow" aria-hidden="true"></div>
  <div class="road" aria-hidden="true"><i class="lane far"></i><i class="lane near"></i></div>

  <div class="display" aria-hidden="true">
    <div class="screen">
      <div class="nav">
        <div class="navin">
          <div class="track">
            <img src={navmap.src} width="400" height="500" alt="" decoding="async" />
            <img src={navmap.src} width="400" height="500" alt="" decoding="async" />
          </div>
          <i class="behind"></i>
          <i class="puck"></i>
          <div class="navcard">
            <svg class="turn" viewBox="0 0 24 24" focusable="false"><path d="M7 20v-8a3 3 0 0 1 3-3h7M13 5l4 4-4 4" /></svg>
            <span class="navtxt">
              <b class="vals v5">{turn.map((v) => <span>{v} m</span>)}</b>
              <small>Oak Street</small>
            </span>
          </div>
          <div class="eta">
            <b class="vals v3">{km.map((v) => <span>{v} km</span>)}</b>
            <small>18 min</small>
          </div>
        </div>
      </div>
      <div class="half">
        <div class="mirrored">
          <img src={ui.src} width="540" height="1170" alt="" decoding="async" />
        </div>
      </div>
      <div class="landfull">
        <div class="scene">
          <img class="art" src={road.src} width="1200" height="600" alt="" decoding="async" />
          <img class="art b" src={roadB.src} width="1200" height="600" alt="" decoding="async" />
          <img class="art c" src={roadC.src} width="1200" height="600" alt="" decoding="async" />
          <i class="shade"></i>
          <div class="ctrl">
            <b class="vals time">{times.map((t) => <span>{t} / 4:10</span>)}</b>
            <i class="bar"><b class="fill"></b><i class="kn"><u class="kdot"><s class="kring"></s></u></i></i>
          </div>
        </div>
      </div>
      <i class="splitbtn"><u class="sring"></u></i>
      <div class="status"><span class="gear">D</span><span class="spd">64<small>km/h</small></span></div>
    </div>
  </div>

  <svg class="arcs" viewBox="0 0 100 62" aria-hidden="true" focusable="false">
    {arcs.map((d, i) => <path class={`arc arc-${i + 1}`} d={d} />)}
  </svg>

  <div class="phone-float" aria-hidden="true">
    <div class="phone">
      <div class="phone-screen">
        <div class="portrait">
          <img src={ui.src} width="540" height="1170" alt="" decoding="async" />
        </div>
        <div class="land">
          <div class="scene">
            <img class="art" src={road.src} width="1200" height="600" alt="" decoding="async" />
            <img class="art b" src={roadB.src} width="1200" height="600" alt="" decoding="async" />
            <img class="art c" src={roadC.src} width="1200" height="600" alt="" decoding="async" />
            <i class="shade"></i>
            <div class="ctrl">
              <b class="vals time">{times.map((t) => <span>{t} / 4:10</span>)}</b>
              <i class="bar"><b class="fill"></b><i class="kn"><u class="kdot"><s class="kring"></s></u></i></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="hand-clip" aria-hidden="true">
    <div class="hand">
      <svg class="hand-art" viewBox="0 0 120 260" focusable="false">
        <path class="sleeve" d="M36 150h66l5 110H32z" />
        <path class="sleeve-line" d="M36 156h66" />
        <rect class="skin-d" x="42" y="118" width="58" height="46" rx="10" />
        <rect class="skin" x="35" y="4" width="22" height="104" rx="11" />
        <rect class="skin" x="58" y="62" width="21" height="62" rx="10.5" />
        <rect class="skin" x="78" y="68" width="20" height="56" rx="10" />
        <rect class="skin" x="26" y="74" width="74" height="68" rx="26" />
        <rect class="skin-d" x="57" y="62" width="2" height="24" rx="1" />
        <rect class="skin-d" x="77" y="70" width="2" height="22" rx="1" />
        <path class="skin" d="M24 96c-10 4-14 16-8 28 5 10 16 14 26 12l-4-38z" />
        <path class="skin-d" d="M22 104c-6 6-6 16-1 24" />
      </svg>
      <span class="pill"><i></i>Passenger</span>
    </div>
  </div>
</div>

<style>
  .hero-mockup {
    --accent: #4c7dff;
    --skin: #ecd2bf;
    --skin-d: #d3b29b;
    --sleeve: #3a4770;
    container-type: inline-size;
    position: relative;
    width: 100%;
    max-width: 880px;
    margin-inline: auto;
    aspect-ratio: 100 / 62;
    user-select: none;
  }
  .hero-mockup img {
    display: block;
  }
  .hero-mockup i,
  .hero-mockup s,
  .hero-mockup u,
  .hero-mockup b {
    display: block;
    text-decoration: none;
    font-style: normal;
  }

  /* Soft light on the dash below the display */
  .glow {
    position: absolute;
    left: 24cqw;
    top: 44cqw;
    width: 70cqw;
    height: 15cqw;
    background: radial-gradient(ellipse 50% 100% at 50% 0%, rgb(30 79 216 / 0.5), transparent 72%);
    opacity: 0.85;
  }

  /* Road below the display: lane lines slide past to say "driving" */
  .road {
    position: absolute;
    left: 38cqw;
    top: 50.5cqw;
    width: 56cqw;
    height: 11.5cqw;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 22%, #000 78%, transparent), linear-gradient(180deg, transparent, #000 35%, #000 65%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent, #000 22%, #000 78%, transparent), linear-gradient(180deg, transparent, #000 35%, #000 65%, transparent);
    mask-composite: intersect;
    opacity: 0.4;
  }
  /* top-down lane lines that stream toward the viewer (down), like the map */
  .lane {
    position: absolute;
    left: 0;
    width: 100%;
    will-change: transform;
  }
  .lane.near {
    top: -18.4cqw;
    height: 29.9cqw;
    background: repeating-linear-gradient(180deg, rgb(255 255 255 / 0.8) 0 2.2cqw, transparent 2.2cqw 4.6cqw);
    -webkit-mask-image: repeating-linear-gradient(90deg, transparent 0 4.4cqw, #000 4.4cqw 4.9cqw, transparent 4.9cqw 9.3cqw);
    mask-image: repeating-linear-gradient(90deg, transparent 0 4.4cqw, #000 4.4cqw 4.9cqw, transparent 4.9cqw 9.3cqw);
  }
  .lane.far {
    top: -9.2cqw;
    height: 20.7cqw;
    background: repeating-linear-gradient(180deg, rgb(255 255 255 / 0.5) 0 1cqw, transparent 1cqw 2.3cqw);
    -webkit-mask-image: repeating-linear-gradient(90deg, transparent 0 2.2cqw, #000 2.2cqw 2.45cqw, transparent 2.45cqw 4.65cqw);
    mask-image: repeating-linear-gradient(90deg, transparent 0 2.2cqw, #000 2.2cqw 2.45cqw, transparent 2.45cqw 4.65cqw);
    opacity: 0.5;
  }

  /* Car centre display */
  .display {
    position: absolute;
    left: 18cqw;
    top: 0;
    width: 76cqw;
    aspect-ratio: 16 / 10;
    padding: 1.1cqw;
    box-sizing: border-box;
    border-radius: 2.8cqw;
    background: linear-gradient(160deg, #232938 0%, #0b0e15 50%, #06080c 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.09),
      inset 0 1px 0 rgb(255 255 255 / 0.2),
      0 0 0 1px rgb(0 0 0 / 0.7),
      0 3cqw 6cqw -2cqw rgb(0 0 0 / 0.8);
  }
  .display .screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 1.8cqw;
    background:
      radial-gradient(ellipse 70% 60% at 50% 40%, #10141d, #000 75%);
  }

  /* Split screen. Left (larger): the car's own navigation (generic dark map, scrolls under a fixed puck) */
  .nav {
    position: absolute;
    inset: 0 28.4% 0 0;
    overflow: hidden;
  }
  .navin {
    position: absolute;
    inset: 0;
    background: #0f1420;
  }
  .track {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    will-change: transform;
  }
  .track img {
    width: 100%;
    height: auto;
  }
  /* travelled part of the route, behind the vehicle, is dimmed */
  .behind {
    position: absolute;
    left: 50%;
    top: 66%;
    bottom: 0;
    width: 2.4cqw;
    margin-left: -1.2cqw;
    background: linear-gradient(to bottom, rgb(15 20 32 / 0.55), rgb(15 20 32 / 0.8));
  }
  .puck {
    position: absolute;
    left: 50%;
    top: 66%;
    width: 4.4cqw;
    height: 4.4cqw;
    margin: -2.2cqw 0 0 -2.2cqw;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 0.7cqw rgb(76 125 255 / 0.45), 0 0.5cqw 1.2cqw rgb(0 0 0 / 0.6);
  }
  .puck::after {
    content: '';
    position: absolute;
    inset: 0.9cqw;
    background: #1e4fd8;
    clip-path: polygon(50% 0, 100% 100%, 50% 75%, 0 100%);
  }
  .navcard {
    position: absolute;
    right: 1.6cqw;
    top: 6cqw;
    display: flex;
    align-items: center;
    gap: 1cqw;
    padding: 0.9cqw 1.6cqw 0.9cqw 1cqw;
    border-radius: 1.4cqw;
    background: rgb(10 13 24 / 0.88);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    color: #fff;
    font: 600 max(8px, 1.9cqw) / 1.15 system-ui, sans-serif;
  }
  .turn {
    width: 3.4cqw;
    height: 3.4cqw;
    fill: none;
    stroke: #fff;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .navtxt { display: block; }
  .navtxt small,
  .eta small {
    display: block;
    font-size: 0.7em;
    font-weight: 500;
    opacity: 0.65;
  }
  .eta {
    position: absolute;
    right: 1.6cqw;
    bottom: 1.8cqw;
    padding: 0.9cqw 1.6cqw;
    border-radius: 1.4cqw;
    background: rgb(10 13 24 / 0.88);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    color: #fff;
    font: 600 max(8px, 1.9cqw) / 1.15 system-ui, sans-serif;
    text-align: right;
  }
  .hero-mockup b.vals {
    display: grid;
    font-weight: 600;
  }
  .vals span {
    grid-area: 1 / 1;
    opacity: 0;
  }
  .vals span:first-child { opacity: 1; }
  .v5 span { justify-self: start; }

  /* Right: the mirrored phone, exactly the width of a portrait phone picture at display height */
  .half {
    position: absolute;
    inset: 0 0 0 71.6%;
    background: transparent;
  }
  .mirrored {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: #000;
    box-shadow: -1px 0 0 rgb(255 255 255 / 0.14);
  }
  .landfull {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .portrait > img, .mirrored > img { width: 100%; height: 100%; }

  /* Split-screen button on the car display */
  .splitbtn {
    position: absolute;
    left: 62.6cqw;
    top: 18.6cqw;
    width: 4.6cqw;
    height: 4.6cqw;
    border-radius: 1.2cqw;
    background: rgb(10 13 24 / 0.72);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35);
    opacity: 0;
  }
  .splitbtn::before {
    content: '';
    position: absolute;
    inset: 1.1cqw;
    border-radius: 0.4cqw;
    box-shadow: inset 0 0 0 max(1.5px, 0.18cqw) #fff;
    background: linear-gradient(90deg, rgb(255 255 255 / 0.55) 50%, transparent 50%);
  }
  .sring {
    position: absolute;
    inset: -1.2cqw;
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgb(255 255 255 / 0.9), 0 0 0 5px rgb(76 125 255 / 0.5);
    background: rgb(76 125 255 / 0.28);
    opacity: 0;
  }

  /* Landscape scene (shared by display and phone) */
  .scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #120d22;
  }
  .art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
  }
  .art.b,
  .art.c { opacity: 0; }
  .shade {
    position: absolute;
    inset: auto 0 0;
    height: 34%;
    background: linear-gradient(to top, rgb(8 6 18 / 0.65), transparent);
  }
  .ctrl {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .time {
    position: absolute;
    left: 7%;
    bottom: 11%;
    color: #fff;
    font: 600 max(8px, 1.9cqw) / 1 system-ui, sans-serif;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.6);
  }
  .time span { justify-self: start; }
  .bar {
    position: absolute;
    left: 7%;
    right: 7%;
    bottom: 7%;
    height: 1.3%;
    min-height: 2px;
    border-radius: 99px;
    background: rgb(255 255 255 / 0.3);
  }
  .fill {
    width: 100%;
    height: 100%;
    border-radius: 99px;
    background: #fff;
    transform-origin: 0 50%;
    transform: scaleX(0.336);
  }
  .kn {
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 0;
    transform: translateX(33.6%);
  }
  .kdot {
    position: absolute;
    left: 0;
    top: 0;
    width: 2.4cqw;
    height: 2.4cqw;
    margin: -1.2cqw 0 0 -1.2cqw;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 0.3cqw rgb(76 125 255 / 0.55), 0 0.3cqw 0.8cqw rgb(0 0 0 / 0.5);
  }
  .kring {
    position: absolute;
    inset: -1.6cqw;
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgb(255 255 255 / 0.9), 0 0 0 5px rgb(76 125 255 / 0.5);
    background: rgb(76 125 255 / 0.28);
    opacity: 0;
  }

  /* Phone: landscape layer is pre-rotated so it reads upright once the phone turns */
  .phone-screen {
    position: relative;
    aspect-ratio: 1080 / 2340;
  }
  .land {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 38.79cqw;
    height: 17.9cqw;
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }
  
  /* Display status strip: driving cue (generic, not a car UI) */
  .status {
    position: absolute;
    left: 2.2cqw;
    top: 1.6cqw;
    display: flex;
    align-items: center;
    gap: 1.2cqw;
    padding: 0.5cqw 1.4cqw 0.5cqw 0.6cqw;
    border-radius: 99px;
    background: rgb(10 12 22 / 0.62);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    color: #fff;
    font: 600 max(8px, 1.7cqw) / 1 system-ui, sans-serif;
    letter-spacing: 0.02em;
  }
  .gear {
    display: grid;
    place-items: center;
    width: 1.5em;
    height: 1.5em;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
  }
  .spd small {
    margin-left: 0.3em;
    font-size: 0.7em;
    font-weight: 500;
    opacity: 0.7;
  }

  .arcs {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    transform-origin: 25.6cqw 30cqw;
  }
  .arc {
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.8;
    stroke-linecap: round;
  }
  .arc-1 { --o: 0.95; opacity: var(--o); }
  .arc-2 { --o: 0.65; opacity: var(--o); }
  .arc-3 { --o: 0.4; opacity: var(--o); }

  /* Phone, in front on the left */
  .phone-float {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 19cqw;
  }
  .phone {
    box-sizing: border-box;
    padding: 0.55cqw;
    border-radius: 2.8cqw;
    background: linear-gradient(160deg, #2a3040 0%, #0d1018 60%, #080a0f 100%);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      inset 0 1px 0 rgb(255 255 255 / 0.25),
      0 0 0 1px rgb(0 0 0 / 0.7),
      0 2.4cqw 5cqw -1.5cqw rgb(0 0 0 / 0.9);
  }
  .phone-screen {
    overflow: hidden;
    border-radius: 2.2cqw;
    background: #000;
    line-height: 0;
  }
  .portrait {
    position: absolute;
    inset: 0;
  }
  .portrait img {
    width: 100%;
    height: 100%;
  }

  /* Passenger hand: tip of the index finger sits on the tap point (centre of the display) */
  .hand-clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .hand {
    position: absolute;
    left: 39.4cqw;
    top: 42.3cqw;
    width: 16cqw;
    height: 34.7cqw;
  }
  .hand-art {
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: 6.16cqw 0.56cqw;
    transform: rotate(-25deg);
    filter: drop-shadow(0 1cqw 1.4cqw rgb(0 0 0 / 0.45));
    overflow: visible;
  }
  .skin { fill: var(--skin); }
  .skin-d { fill: var(--skin-d); }
  .sleeve { fill: var(--sleeve); }
  .sleeve-line { stroke: var(--accent); stroke-width: 3; fill: none; }
  .hand-art path.skin-d { fill: none; stroke: var(--skin-d); stroke-width: 3; stroke-linecap: round; }
  .pill {
    position: absolute;
    left: 6cqw;
    top: -8cqw;
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.55em 1em 0.55em 0.8em;
    border-radius: 99px;
    background: rgb(14 18 32 / 0.92);
    box-shadow: inset 0 0 0 1px rgb(124 157 255 / 0.55);
    color: #fff;
    font: 600 max(9px, 1.8cqw) / 1 system-ui, sans-serif;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .pill i {
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: #7c9dff;
  }


  /* ---- Static state (also the reduced-motion still): split screen, music player, navigation; no hand ---- */
  .mirrored,
  .portrait { opacity: 1; }
  .land { opacity: 0; }
  .hand { opacity: 0; }
  .road { opacity: 0.4; }
  .arcs { opacity: 0; transform: translate(6.9cqw, 24.6cqw) scale(0.7); }

  /* ---- Motion: 14 s loop, transforms and opacity (clip-path only for the split resize) ---- */
  @media (prefers-reduced-motion: no-preference) {
    .hero-mockup {
      --loop: 14s;
    }
    .phone-float { animation: float var(--loop) ease-in-out infinite; }
    .phone { animation: turn var(--loop) linear infinite; }
    .arcs { animation: arcs-move var(--loop) linear infinite; }
    .portrait { animation: p-phone var(--loop) linear infinite; }
    .land { animation: l-phone var(--loop) linear infinite; }
    .mirrored { animation: m-col var(--loop) linear infinite; }
    .landfull { animation: m-full var(--loop) linear infinite; }
    .navin { animation: nav-in var(--loop) linear infinite; }
    .splitbtn { animation: sbtn var(--loop) linear infinite; }
    .sring { animation: ring1 var(--loop) linear infinite; }
    .glow { animation: glow var(--loop) ease-in-out infinite; }
    .arc { animation: pulse 3.5s ease-out infinite backwards; }
    .arc-2 { animation-delay: 0.22s; }
    .arc-3 { animation-delay: 0.44s; }
    .road { animation: road-in var(--loop) linear infinite; }
    .lane.near { animation: slide-near 3.5s linear infinite; }
    .lane.far { animation: slide-far 3.5s linear infinite; }
    .track { animation: scroll 28s linear infinite; }

    .ctrl { animation: ctrl var(--loop) linear infinite; }
    .fill { animation: fill var(--loop) linear infinite; }
    .kn { animation: knob var(--loop) linear infinite; }
    .kdot { animation: kdot var(--loop) linear infinite; }
    .kring { animation: kring var(--loop) linear infinite; }
    .art.b { animation: var-b var(--loop) linear infinite; }
    .art.c { animation: var-c var(--loop) linear infinite; }
    .time span:nth-child(1) { animation: t0 var(--loop) linear infinite; }
    .time span:nth-child(2) { animation: t1 var(--loop) linear infinite; }
    .time span:nth-child(3) { animation: t2 var(--loop) linear infinite; }
    .time span:nth-child(4) { animation: t3 var(--loop) linear infinite; }
