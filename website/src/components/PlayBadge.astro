<span class="play" role="img" aria-label="Google Play: coming soon, not available yet">
  <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3.2v17.6c0 .5.5.8.9.5l15-8.8c.4-.2.4-.8 0-1L5.9 2.7c-.4-.3-.9 0-.9.5z" fill="currentColor"/></svg>
  <span><small>Google Play</small><strong>Coming soon</strong></span>
</span>
<style>
  .play { display: inline-flex; align-items: center; gap: 12px; min-height: var(--target); padding: 8px 20px 8px 16px; border: 1.5px dashed var(--line); border-radius: var(--r-1); color: var(--text-muted); cursor: default; }
  .play span { display: flex; flex-direction: column; line-height: 1.2; }
  small { font-size: 0.75rem; letter-spacing: .04em; }
  strong { font: 600 1rem var(--font-display); }
</style>
