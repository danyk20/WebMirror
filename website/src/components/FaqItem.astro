---
interface Props { q: string; open?: boolean }
const { q, open = false } = Astro.props;
---
<details class="faq" open={open}>
  <summary>{q}</summary>
  <div class="a"><slot /></div>
</details>
<style>
  .faq { border: 1px solid var(--line); background: var(--surface); border-radius: var(--r-1); margin-bottom: var(--s-2); }
  summary { cursor: pointer; padding: var(--s-3) 56px var(--s-3) var(--s-3); min-height: var(--target); font: 600 1.0625rem/1.4 var(--font-display); list-style: none; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: var(--s-3); top: 50%; transform: translateY(-50%); font-size: 1.5rem; color: var(--link); }
  .faq[open] summary::after { content: '\2212'; }
  .a { padding: 0 var(--s-3) var(--s-3); color: var(--text-muted); }
  .a :global(p:last-child) { margin-bottom: 0; }
</style>
