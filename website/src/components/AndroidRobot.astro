---
// Android robot head, drawn after Google's Android robot (CC BY 3.0; attribution in Footer.astro).
// Google's brand guidelines ask for the official green #3DDC84.
interface Props { size?: number }
const { size = 20 } = Astro.props;
---
<svg class="android-robot" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path fill="#3DDC84" fill-rule="evenodd" d="M3 18a9 9 0 0 1 18 0z M7.6 14.2a1.1 1.1 0 1 0 2.2 0a1.1 1.1 0 1 0-2.2 0z M14.2 14.2a1.1 1.1 0 1 0 2.2 0a1.1 1.1 0 1 0-2.2 0z" />
  <path stroke="#3DDC84" stroke-width="1.4" stroke-linecap="round" d="M7.3 10.3 5.4 7.2 M16.7 10.3 18.6 7.2" />
</svg>
<style>
  .android-robot { flex: none; vertical-align: middle; }
</style>
