---
// Guide / text page: breadcrumb, h1, lead and a readable column.
import BaseLayout from './BaseLayout.astro';
import { abs, href } from '../lib/site';

interface Props {
  title: string;
  description: string;
  path: string;
  heading: string;
  lead?: string;
  crumb?: string;
  jsonLd?: Record<string, unknown>[];
}
const { title, description, path, heading, lead, crumb = heading, jsonLd = [] } = Astro.props;
const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'WebMirror', item: abs('/') },
    { '@type': 'ListItem', position: 2, name: crumb, item: abs(path) },
  ],
};
---
<BaseLayout title={title} description={description} path={path} jsonLd={[breadcrumb, ...jsonLd]}>
  <div class="wrap page-head">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href={href('/')}>Home</a></li>
        <li aria-current="page">{crumb}</li>
      </ol>
    </nav>
    <h1>{heading}</h1>
    {lead && <p class="lead wrap-text">{lead}</p>}
  </div>
  <div class="wrap body">
    <slot />
  </div>
  <slot name="after" />
</BaseLayout>
<style>
  .body { padding-bottom: var(--s-8); }
</style>
